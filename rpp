#!/usr/bin/env bash
#
# rpp — CLI для управления rustplusplus ботом на VPS.
# start   — восстановить бэкап из приватного репо и поднять бота
# stop    — сделать бэкап, зашифровать, запушить в приватный репо, остановить бота
# status  — статус контейнера + потребление памяти
# logs    — логи бота (ctrl+c для выхода)
# restart — перезапуск контейнера
# update  — обновить образ бота до последней версии
# backup  — сделать бэкап прямо сейчас, не останавливая бота
# menu    — интерактивное меню (по умолчанию)
#
set -euo pipefail

INSTALL_DIR="/opt/rpp"
DATA_DIR="$INSTALL_DIR/data"
BACKUP_FILE="$INSTALL_DIR/backup.tar.gz.gpg"
CLONE_DIR="$INSTALL_DIR/.data-repo"
ENV_FILE="$INSTALL_DIR/.env"

log() { echo -e "\033[1;32m==>\033[0m $*"; }
warn() { echo -e "\033[1;33m!!\033[0m $*"; }

[ -f "$ENV_FILE" ] || { echo "Не найден $ENV_FILE. Запусти bootstrap.sh сначала."; exit 1; }
set -a; source "$ENV_FILE"; set +a
cd "$INSTALL_DIR"

need() {
  local val="${!1:-}"
  [ -n "$val" ] || { echo "Не задана переменная $1 в $ENV_FILE"; exit 1; }
}

git_url() { echo "https://x-access-token:${RPP_GH_TOKEN}@github.com/${RPP_DATA_REPO}.git"; }

# Скачивает последний бэкап из приватного репо (если он там есть).
# Возвращает 0, если бэкап найден и скопирован, 1 если репо пустой/бэкапа нет.
fetch_backup() {
  need RPP_GH_TOKEN; need RPP_DATA_REPO
  rm -rf "$CLONE_DIR"
  if git clone --depth 1 "$(git_url)" "$CLONE_DIR" >/dev/null 2>&1; then
    if [ -f "$CLONE_DIR/backup.tar.gz.gpg" ]; then
      cp "$CLONE_DIR/backup.tar.gz.gpg" "$BACKUP_FILE"
      return 0
    fi
  fi
  return 1
}

decrypt_backup() {
  need RPP_BACKUP_PASSWORD
  log "Восстанавливаю данные из бэкапа"
  mkdir -p "$DATA_DIR"
  gpg --batch --yes --passphrase "$RPP_BACKUP_PASSWORD" --pinentry-mode loopback \
    -o "$INSTALL_DIR/backup.tar.gz" -d "$BACKUP_FILE" \
    || { echo "Не удалось расшифровать бэкап — проверь RPP_BACKUP_PASSWORD"; exit 1; }
  tar xzf "$INSTALL_DIR/backup.tar.gz" -C "$INSTALL_DIR"
  rm -f "$INSTALL_DIR/backup.tar.gz"
}

# Собирает архив, шифрует и форс-пушит как один коммит в приватный репо,
# чтобы репозиторий не разрастался с каждым бэкапом.
push_backup() {
  need RPP_GH_TOKEN; need RPP_DATA_REPO; need RPP_BACKUP_PASSWORD
  [ -d "$DATA_DIR/credentials" ] || { warn "Нет данных для бэкапа (data/ пуст), пропускаю"; return 0; }

  log "Собираю и шифрую бэкап"
  tar czf "$INSTALL_DIR/backup.tar.gz" -C "$INSTALL_DIR" data/credentials data/instances
  gpg --batch --yes --symmetric --cipher-algo AES256 --passphrase "$RPP_BACKUP_PASSWORD" --pinentry-mode loopback \
    -o "$BACKUP_FILE" "$INSTALL_DIR/backup.tar.gz"
  rm -f "$INSTALL_DIR/backup.tar.gz"

  rm -rf "$CLONE_DIR"
  if ! git clone --depth 1 "$(git_url)" "$CLONE_DIR" >/dev/null 2>&1; then
    mkdir -p "$CLONE_DIR"
    (cd "$CLONE_DIR" && git init -q)
  fi
  cd "$CLONE_DIR"
  git checkout --orphan latest_tmp -q 2>/dev/null || git checkout -q --orphan latest_tmp
  find . -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
  cp "$BACKUP_FILE" .
  echo "Обновлено: $(date -u +%FT%TZ)" > README.md
  git add -A
  git -c user.email="rpp-bot@local" -c user.name="rpp-bot" commit -q -m "backup $(date -u +%FT%TZ)"
  git branch -M -f main
  git push -f "$(git_url)" main -q
  cd "$INSTALL_DIR"
  log "Бэкап сохранён в $RPP_DATA_REPO"
}

cmd_start() {
  mkdir -p "$DATA_DIR"/{credentials,instances,logs}
  if fetch_backup; then
    decrypt_backup
  else
    warn "Бэкап в $RPP_DATA_REPO не найден — стартую с чистой конфигурацией (это нормально при первом запуске)"
  fi
  docker compose up -d
  log "Бот запущен. 'rpp logs' — логи, 'rpp menu' — меню управления"
}

cmd_stop() {
  push_backup
  docker compose down
  log "Бот остановлен, данные сохранены в GitHub. Теперь VPS можно безопасно удалять."
}

cmd_status() {
  docker compose ps
  echo
  local cid
  cid=$(docker compose ps -q || true)
  [ -n "$cid" ] && docker stats --no-stream "$cid" || echo "Контейнер не запущен"
}

cmd_logs()      { docker compose logs -f --tail 200; }
cmd_restart()   { docker compose restart; }
cmd_update()    { docker compose pull; docker compose up -d; }
cmd_backupnow() { push_backup; }

cmd_menu() {
  command -v whiptail >/dev/null 2>&1 || { apt-get update -y && apt-get install -y whiptail; }
  while true; do
    CHOICE=$(whiptail --title "rustplusplus manager" --menu "Что делаем?" 20 62 10 \
      1 "Статус бота" \
      2 "Логи (ctrl+c для выхода из меню)" \
      3 "Перезапустить бота" \
      4 "Обновить образ бота" \
      5 "Сделать бэкап сейчас (бот продолжит работать)" \
      6 "Остановить бота и сохранить данные (перед сносом VPS)" \
      7 "Запустить бота / восстановить из бэкапа" \
      8 "Выход" \
      3>&1 1>&2 2>&3) || break
    case "$CHOICE" in
      1) cmd_status; echo; read -rp "Enter для продолжения..." ;;
      2) cmd_logs || true ;;
      3) cmd_restart ;;
      4) cmd_update ;;
      5) cmd_backupnow; read -rp "Enter для продолжения..." ;;
      6) cmd_stop; break ;;
      7) cmd_start ;;
      8) break ;;
    esac
  done
}

case "${1:-menu}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  status)  cmd_status ;;
  logs)    cmd_logs ;;
  restart) cmd_restart ;;
  update)  cmd_update ;;
  backup)  cmd_backupnow ;;
  menu)    cmd_menu ;;
  *) echo "Использование: rpp {start|stop|status|logs|restart|update|backup|menu}" ;;
esac
